# user-service — PRODUCTION environment variables
# Copy to .env on EC2 and fill in real values before running docker-compose.prod.yml
#
# Generate JWT_SECRET:  openssl rand -hex 32
# IMPORTANT: JWT_SECRET must be identical to the value in api-gateway/.env.prod

PORT=3001
DATABASE_URL=postgresql://app_user:CHANGE_ME_DB_PASSWORD@db-user:5432/users_db
JWT_SECRET=CHANGE_ME_RUN_openssl_rand_hex_32
BCRYPT_ROUNDS=12
JWT_EXPIRES_IN=24h
